# AppImage build host: the oldest supported base (glibc 2.35, Qt 6.2) so the
# AppImage runs on Ubuntu 22.04 and anything newer.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config ca-certificates curl file patchelf \
    qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools qt6-l10n-tools \
    qt6-wayland qt6-qpa-plugins libqt6svg6 qt6-gtk-platformtheme \
    libopencv-dev libturbojpeg0-dev libtiff-dev libgl-dev libvulkan-dev libfuse2 \
    libtesseract-dev libleptonica-dev zlib1g-dev libzbar-dev tesseract-ocr-eng tesseract-ocr-fra tesseract-ocr-osd \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /usr/local/bin/linuxdeploy \
      https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
 && curl -fsSL -o /usr/local/bin/linuxdeploy-plugin-qt \
      https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
 && chmod +x /usr/local/bin/linuxdeploy /usr/local/bin/linuxdeploy-plugin-qt
ENV APPIMAGE_EXTRACT_AND_RUN=1
WORKDIR /src
